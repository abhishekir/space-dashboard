{
  "name": "space-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live 3D dashboard tracking JWST, the Nancy Grace Roman Space Telescope, and SpaceX Starship.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node scripts/make-seed.mjs",
    "fetch:telescopes": "node scripts/fetch-telescopes.mjs",
    "fetch:starship": "node scripts/fetch-starship.mjs",
    "fetch:news": "node scripts/fetch-news.mjs",
    "fetch:all": "npm run fetch:telescopes && npm run fetch:starship && npm run fetch:news",
    "shots": "node scripts/screenshot.mjs",
    "smoke": "node scripts/screenshot.mjs --url"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "vite": "^5.4.0"
  }
}
